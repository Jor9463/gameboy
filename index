function line(){
 const L=io[0x40],o=ly*160,bgp=io[0x47];let win=0;
 if(L&1){
  const y=ly+io[0x42]&255,mb=L&8?0x1C00:0x1800,sx=io[0x43];
  for(let x=0;x<160;x++){
   const p=x+sx&255,t=vram[mb+(y>>3<<5)+(p>>3)],a=L&16?t*16:0x1000+(t<<24>>24)*16+0,l=(y&7)*2,b=7-(p&7);
   const c=((vram[a+l+1]>>b&1)<<1)|(vram[a+l]>>b&1);bgc[x]=c;px[o+x]=PAL[bgp>>(c*2)&3]}
  const wy=io[0x4A],wx=io[0x4B]-7;
  if(L&32&&ly>=wy&&wx<160){
   const wm=L&64?0x1C00:0x1800;
   for(let x=Math.max(wx,0);x<160;x++){
    const p=x-wx,t=vram[wm+(wl>>3<<5)+(p>>3)],a=L&16?t*16:0x1000+(t<<24>>24)*16,l=(wl&7)*2,b=7-(p&7);
    const c=((vram[a+l+1]>>b&1)<<1)|(vram[a+l]>>b&1);bgc[x]=c;px[o+x]=PAL[bgp>>(c*2)&3]}
   wl++}
 }else for(let x=0;x<160;x++){bgc[x]=0;px[o+x]=PAL[0]}
 if(L&2){
  const h=L&4?16:8,sp=[];
  for(let i=0;i<40&&sp.length<10;i++){const y=oam[i*4]-16;if(ly>=y&&ly<y+h)sp.push({i,x:oam[i*4+1]-8,y,t:oam[i*4+2],f:oam[i*4+3]})}
  sp.sort((a,b)=>a.x-b.x||a.i-b.i);
  for(let n=sp.length-1;n>=0;n--){
   const s=sp[n];let r=ly-s.y;if(s.f&64)r=h-1-r;
   const a=(h==16?s.t&0xFE:s.t)*16+r*2,pal=io[s.f&16?0x49:0x48];
   for(let i=0;i<8;i++){const xx=s.x+i;if(xx<0||xx>159)continue;
    const b=s.f&32?i:7-i,c=((vram[a+1]>>b&1)<<1)|(vram[a]>>b&1);
    if(!c||(s.f&128&&bgc[xx]))continue;
    px[o+xx]=PO[s.f>>4&1][pal>>(c*2)&3]}}}}

