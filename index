 if(!(io[0x40]&128))return;
 lc+=c;let w=0;
 if(lc>=456){lc-=456;ly++;w=1;lof=0;
  if(ly==144){setMode(1);io[15]|=1}else if(ly>153){ly=0;wl=0}}
 if(w)statChk();
